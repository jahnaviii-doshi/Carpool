-- Shared pgTAP helpers. Include at the top of a test (inside its transaction):
--   \ir _helpers.psql
-- Everything is created in pg_temp, so it disappears with the transaction.

-- Creates a confirmed auth user. The auth.users triggers run as normal, so a
-- profile with the right college_id is created (or the insert is rejected).
create function pg_temp.create_user(p_email text)
returns uuid
language sql
as $$
  insert into auth.users (
    id, instance_id, aud, role, email, email_confirmed_at,
    raw_app_meta_data, raw_user_meta_data, created_at, updated_at
  ) values (
    gen_random_uuid(), '00000000-0000-0000-0000-000000000000', 'authenticated',
    'authenticated', p_email, now(), '{"provider":"email"}', '{}', now(), now()
  )
  returning id;
$$;

-- Creates a user who has verified by OTP and finished onboarding.
create function pg_temp.create_onboarded_user(p_email text, p_phone text, p_name text)
returns uuid
language plpgsql
as $$
declare
  v_id uuid := pg_temp.create_user(p_email);
begin
  update public.profiles
     set email_verified_at = now(), onboarded_at = now(), terms_accepted_at = now(),
         full_name = p_name, role = 'student'
   where id = v_id;
  insert into public.private_contacts (user_id, phone_e164) values (v_id, p_phone);
  return v_id;
end;
$$;

-- Act as a signed-in user for the rest of the transaction (until
-- pg_temp.logout()). The JWT carries an OTP `amr` entry stamped `p_otp_at`.
create function pg_temp.login_as(p_uid uuid, p_otp_at timestamptz default now())
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', json_build_object(
    'sub', p_uid, 'role', 'authenticated', 'aud', 'authenticated',
    'amr', json_build_array(json_build_object(
      'method', 'otp', 'timestamp', extract(epoch from p_otp_at)::bigint))
  )::text, true);
  perform set_config('role', 'authenticated', true);
end;
$$;

create function pg_temp.login_anon()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
  perform set_config('role', 'anon', true);
end;
$$;

create function pg_temp.logout()
returns void
language plpgsql
as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
end;
$$;


-- A second college used by isolation tests.
with c as (
  insert into public.colleges (name, short_name, city)
  values ('College B (test)', 'CB', 'Ajman') returning id
)
insert into public.college_domains (college_id, domain) select id, 'collegeb.test' from c;

-- Local time in Dubai `p_days` days from now, at `p_time`.
create function pg_temp.dubai_local(p_days int, p_time time default '08:00')
returns timestamp
language sql
as $$
  select ((now() at time zone 'Asia/Dubai')::date + p_days) + p_time;
$$;

-- As the given user: add a car and post a one-off offer from Al Nahda
-- (Sharjah) to the AUS campus tomorrow at 08:00. Returns the offer id.
create function pg_temp.post_offer(p_uid uuid, p_women_only boolean default false)
returns uuid
language plpgsql
as $$
declare
  v_vehicle uuid;
  v_offer uuid;
begin
  perform pg_temp.login_as(p_uid);
  v_vehicle := public.save_vehicle('car', 'Toyota', 'Corolla', 'White', 3, 'SHJ 3 12345');
  v_offer := public.save_ride_offer(
    p_vehicle_id => v_vehicle,
    p_origin_lng => 55.3700, p_origin_lat => 25.3050, p_origin_label => 'Villa 12, Street 5, Al Nahda',
    p_origin_area => 'Al Nahda',
    p_dest_lng => 55.4905, p_dest_lat => 25.3120, p_dest_label => 'AUS Main Gate',
    p_dest_area => 'University City',
    p_depart_local => pg_temp.dubai_local(1),
    p_seats_total => 2,
    p_women_only => p_women_only);
  perform pg_temp.logout();
  return v_offer;
end;
$$;

-- As the given user: post a one-off request from Muwaileh to campus tomorrow.
create function pg_temp.post_request(p_uid uuid)
returns uuid
language plpgsql
as $$
declare
  v_request uuid;
begin
  perform pg_temp.login_as(p_uid);
  v_request := public.save_ride_request(
    p_pickup_lng => 55.4500, p_pickup_lat => 25.3000, p_pickup_label => 'Building 7, Muwaileh',
    p_pickup_area => 'Muwaileh',
    p_dest_lng => 55.4905, p_dest_lat => 25.3120, p_dest_label => 'AUS Main Gate',
    p_dest_area => 'University City',
    p_date => (now() at time zone 'Asia/Dubai')::date + 1,
    p_window_start => '07:30', p_window_end => '08:30');
  perform pg_temp.logout();
  return v_request;
end;
$$;
