# Copy to .env.local and fill in. Never commit .env.local.
# Local values come from `pnpm exec supabase status -o env`.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The anon / publishable key. Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used only by admin scripts / tests, never in request paths.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Region defaults (time zone, currency, phone prefix, SOS number): AE | IN
NEXT_PUBLIC_REGION=AE

# --- Email notifications (Resend) — Milestone 7 ---
RESEND_API_KEY=
EMAIL_FROM="CampusPool <noreply@your-verified-domain.example>"

# --- Maps & geocoding ---
# Tile layer for Leaflet. The openstreetmap.org tiles are fine for development
# only; use a hosted tile provider (MapTiler, Stadia, ...) in production.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"
# Geocoder used by the server-side search proxy: nominatim | ola | google
GEOCODER_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OLA_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- Routing (optional). none = straight line origin -> destination ---
ROUTER_PROVIDER=none
OSRM_BASE_URL=
ORS_API_KEY=
